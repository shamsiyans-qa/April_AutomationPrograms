<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MultiBroswerTesting" parallel="tests">
 
  <test name="ChromeTest">
  <parameter name="browser" value="Chrome"></parameter>
  
    <classes>
      <class name="testscript.LoginTest">
      <methods><include name="verifyTheUserisAbletoLoginUsingValidCredentials"></include>
      <include name="validUserNameInvalidPassword"></include>
      </methods>
      </class>
    </classes>
  </test> <!-- Test -->
  
 
  <test name="FirefoxTest">
  <parameter name="browser" value="Firefox"></parameter>
  
    <classes>
      <class name="testscript.LoginTest">
      <methods><include name="verifyTheUserisAbletoLoginUsingValidCredentials"></include>
      <include name="validUserNameInvalidPassword"></include>
      </methods>
      </class>
    </classes>
  </test> <!-- Test -->
</suite> <!-- Suite -->
